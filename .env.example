# Environment configuration example, rename to .env to have it automatically loaded

# OpenAI API Key
OPENAI_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# SAIA (GWDG Academic Cloud), used by sempipes.get_default_saia_config()
SAIA_API_KEY=
SAIA_BASE_URL=https://chat-ai.academiccloud.de/v1
# Optional: other SAIA models (list them as described in docs/configuration.md)
# SAIA_CODE_GENERATION_MODEL=qwen3-coder-next
# SAIA_BATCH_PROCESSING_MODEL=qwen3.6-35b-a3b

# Default LLM provider for scripts, notebooks and tests: gemini (if unset) or saia
# SEMPIPES_LLM_PROVIDER=saia

# HuggingFace Token for sem_extract_features
HF_TOKEN=
